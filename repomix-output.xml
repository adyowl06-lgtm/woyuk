    <!-- GLOBAL JAVASCRIPT UNTUK CONTROL LOADING SCREEN -->
    <script>
        // Fungsi Sembunyikan Loading Screen setelah Halaman Selesai Load
        function hideGlobalLoading() {
            const loadingScreen = document.getElementById('global-loading-screen');
            if (loadingScreen) {
                loadingScreen.classList.add('loading-hidden');
            }
        }

        // Fungsi Tampilkan Loading Screen
        function showGlobalLoading() {
            const loadingScreen = document.getElementById('global-loading-screen');
            if (loadingScreen) {
                loadingScreen.classList.remove('loading-hidden');
            }
        }

        // 1. Sembunyikan Loading ketika Window / DOM Selesai Dimuat
        window.addEventListener('load', function() {
            // Beri penundaan singkat (300ms) agar transisi terasa smooth
            setTimeout(hideGlobalLoading, 300);
        });

        // 2. Tampilkan Loading saat User Memicu Submit Form (Login, Register, Simpan Profil, dll)
        document.addEventListener('submit', function(e) {
            showGlobalLoading();
        });

        // 3. Tampilkan Loading saat User Mengklik Link Pindah Halaman
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href && !link.href.startsWith('#') && !link.href.startsWith('javascript:') && link.target !== '_blank') {
                showGlobalLoading();
            }
        });
    </script>

