@push('scripts')
<script>
    let activeMap = null;
    let userMarker = null;
    let polylineRoute = null;
    let pathCoordinates = [];
    let startTimeMillis = {{ \Carbon\Carbon::parse($activeActivity->start_time)->getTimestamp() * 1000 }};

    document.addEventListener("DOMContentLoaded", function() {
        initTrackingMap();
        startLiveTimer();
    });

    // FUNCTION CONTROL MODAL BATAL/KELUAR (ANIMASI GETAR)
    function openCancelModal() {
        const modal = document.getElementById('cancel-activity-modal');
        const card = document.getElementById('cancel-modal-card');
        
        modal.classList.remove('hidden');
        card.classList.remove('animate-alert-shake');
        void card.offsetWidth; // Trigger Reflow
        card.classList.add('animate-alert-shake');
    }

    function closeCancelModal() {
        document.getElementById('cancel-activity-modal').classList.add('hidden');
    }

    // FUNCTION CONTROL MODAL HENTIKAN AKTIVITAS (ANIMASI GETAR)
    function openStopModal() {
        const modal = document.getElementById('stop-activity-modal');
        const card = document.getElementById('stop-modal-card');

        modal.classList.remove('hidden');
        card.classList.remove('animate-alert-shake');
        void card.offsetWidth; // Trigger Reflow
        card.classList.add('animate-alert-shake');
    }

    function closeStopModal() {
        document.getElementById('stop-activity-modal').classList.add('hidden');
    }

    // 1. Inisialisasi Peta & Geolocation Presisi Tinggi Realtime
    function initTrackingMap() {
        // Inisialisasi Leaflet Map
        activeMap = L.map('map', {
            zoomControl: false,
            attributionControl: false
        }).setView([-6.200000, 106.816666], 15);

        // BEBAS API KEY: Menggunakan OpenStreetMap / Tile Server Publik
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            subdomains: ['a', 'b', 'c']
        }).addTo(activeMap);

        // Garis Rute Perjalanan (Polyline Oranye)
        polylineRoute = L.polyline([], {
            color: '#f97316',
            weight: 5,
            opacity: 0.9,
            lineCap: 'round'
        }).addTo(activeMap);

        // Geolocation Watch Position dengan Presisi Tinggi (High Accuracy)
        if ("geolocation" in navigator) {
            navigator.geolocation.watchPosition(
                function(position) {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    const accuracy = Math.round(position.coords.accuracy);

                    // Update Badge Status GPS (Akurat/Presisi)
                    const gpsStatusEl = document.getElementById('gps-status');
                    if (gpsStatusEl) {
                        if (accuracy <= 30) {
                            gpsStatusEl.innerText = `GPS AKTIF (${accuracy}M)`;
                            gpsStatusEl.className = "text-xs font-bold text-emerald-400 uppercase font-mono";
                        } else {
                            gpsStatusEl.innerText = `GPS LEMAH (${accuracy}M)`;
                            gpsStatusEl.className = "text-xs font-bold text-amber-400 uppercase font-mono";
                        }
                    }

                    const newLatLng = [lat, lng];

                    // Centering Peta ke Lokasi Pengguna
                    activeMap.setView(newLatLng, 17);

                    // Buat/Update Marker Penanda Posisi
                    const userIcon = L.divIcon({
                        className: 'user-location-marker',
                        iconSize: [16, 16],
                        iconAnchor: [8, 8]
                    });

                    if (userMarker) {
                        userMarker.setLatLng(newLatLng);
                    } else {
                        userMarker = L.marker(newLatLng, { icon: userIcon }).addTo(activeMap);
                    }

                    // Tambahkan Titik Rute ke Peta
                    pathCoordinates.push(newLatLng);
                    polylineRoute.setLatLngs(pathCoordinates);
                },
                function(error) {
                    const gpsStatusEl = document.getElementById('gps-status');
                    if (gpsStatusEl) {
                        gpsStatusEl.innerText = "GPS OFF / UNKNOWN";
                        gpsStatusEl.className = "text-xs font-bold text-red-400 uppercase font-mono";
                    }
                },
                {
                    enableHighAccuracy: true, // Memaksa Sensor GPS Presisi Tinggi Active
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }
    }

    // 2. Timer StopWatch Live
    function startLiveTimer() {
        setInterval(() => {
            const now = Date.now();
            const elapsedSec = Math.floor((now - startTimeMillis) / 1000);

            const hours = String(Math.floor(elapsedSec / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((elapsedSec % 3600) / 60)).padStart(2, '0');
            const seconds = String(elapsedSec % 60).padStart(2, '0');

            const timerEl = document.getElementById('live-timer');
            if (timerEl) {
                timerEl.innerText = `${hours}:${minutes}:${seconds}`;
            }
        }, 1000);
    }
</script>
